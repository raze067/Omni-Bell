rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bell/{document} {
      allow read, write: if true;
    }
    match /presence/{document} {
      allow read, write: if true;
    }
    match /rooms/{roomId} {
      allow read, write: if true;
      match /bell/{document} {
        allow read, write: if true;
      }
      match /presence/{document} {
        allow read, write: if true;
      }
    }
  }
}

